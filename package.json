{
  "name": "dsh-plugin-cron-scheduler",
  "description": "Cron scheduler plugin for DeepSeek Harness: schedule agent tasks via natural language or a sidebar UI, with fixed/new session strategies, run history, manual trigger, and live sync.",
  "version": "0.2.4",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "types/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "cron",
    "scheduler",
    "agent",
    "task-scheduler",
    "automation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBlackTong/dsh-plugin-cron.git"
  },
  "bugs": {
    "url": "https://github.com/LittleBlackTong/dsh-plugin-cron/issues"
  },
  "homepage": "https://github.com/LittleBlackTong/dsh-plugin-cron#readme"
}
